{
  "name": "obsidian-ledger-statistics",
  "version": "1.1.3",
  "private": true,
  "description": "Local, read-only ledger statistics for Obsidian desktop and mobile.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:build": "node esbuild.test.mjs",
    "test": "npm run test:build && node --test tests/*.test.cjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.3"
  }
}
